<div class="page-main">
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:3rem;align-items:center;">
    <div>
      {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 800 | image_tag }}{%- endif -%}
    </div>
    <div>
      <h1>{{ product.title }}</h1>
      <p style="font-size:1.5rem;margin-bottom:1rem;">{{ product.selected_or_first_available_variant.price | money }}</p>
      <div style="margin-bottom:1.5rem;color:var(--muted-color);">{{ product.description }}</div>
      {%- form 'product', product -%}
        <select name="id">
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>
          {%- endfor -%}
        </select>
        <button type="submit" class="btn"{% unless product.available %} disabled{% endunless %}>
          {%- if product.available -%}{{ 'general.add_to_cart' | t }}{%- else -%}{{ 'general.sold_out' | t }}{%- endif -%}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>
{% schema %}{ "name": "Product" }{% endschema %}
