<header class="header" {{ section.shopify_attributes }}>
  <a href="{{ routes.root_url }}" class="logo" style="color:inherit;text-decoration:none;">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" />
      <path d="M12 8V16M8 12H16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <span>{{ section.settings.logo_text | default: shop.name }}</span>
  </a>
  <nav class="nav glass">
    {%- for link in linklists[section.settings.menu].links -%}
      <a href="{{ link.url }}" class="nav-item{% if link.active %} active{% endif %}">{{ link.title }}</a>
    {%- endfor -%}
  </nav>
  <a href="{{ section.settings.contact_url }}" class="contact-btn" style="text-decoration:none;">{{ section.settings.contact_label }}</a>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Soda" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "contact_label", "label": "Contact button label", "default": "Contact Us" },
    { "type": "url", "id": "contact_url", "label": "Contact button link" }
  ]
}
{% endschema %}
